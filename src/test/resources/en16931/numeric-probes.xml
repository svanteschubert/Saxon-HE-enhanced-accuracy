<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic arithmetic inputs, independent of the official EN16931 rules. -->
<probes>
  <net>-3.50</net>
  <rate>19</rate>
  <a>0.1</a>
  <b>0.2</b>
  <c>0.3</c>
  <!-- Invoice lines: quantity (BT-129) x net price (BT-146), price base quantity 1 -->
  <!-- 1 x 1.005 = 1.005: binary xs:double stores 1.00499999999999989... -->
  <binary-quantity>1</binary-quantity>
  <binary-price>1.005</binary-price>
  <!-- -3 x 2.125 = -6.375: exact in binary, only the negative midpoint direction differs -->
  <midpoint-quantity>-3</midpoint-quantity>
  <midpoint-price>2.125</midpoint-price>
</probes>
